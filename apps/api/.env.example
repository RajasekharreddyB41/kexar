# -----------------------------------------------------------------------------
# Kexar backend env vars. Copy to .env and fill in the real values.
# All TRUEFOUNDRY_* and DATABASE_URL are required for a working backend.
# -----------------------------------------------------------------------------

# Render Postgres connection string.
# Format: postgresql://user:password@host.region-postgres.render.com/dbname
DATABASE_URL=postgresql://user:password@host.oregon-postgres.render.com/dbname

# TrueFoundry AI Gateway API key. Get one at https://app.truefoundry.com/
# Developer Plan is free for the hackathon.
TRUEFOUNDRY_API_KEY=tfy-your-key-here

# TrueFoundry gateway base URL. Leave as-is unless TrueFoundry changes it.
TRUEFOUNDRY_BASE_URL=https://gateway.truefoundry.ai/api/inference/openai

# Model identifiers. Three are intentionally simulated stubs for the
# hackathon cascade demo (we have no card on file for OpenAI/Anthropic/
# Google through TrueFoundry). The runtime fakes upstream failures on
# any model starting with "simulated-". Groq is the real backstop.
TRUEFOUNDRY_MODEL_CLAUDE=simulated-claude-sonnet-4-5
TRUEFOUNDRY_MODEL_GPT4O=simulated-gpt-4o
TRUEFOUNDRY_MODEL_GEMINI=simulated-gemini-2-5-flash
TRUEFOUNDRY_MODEL_GROQ=groq/llama-3.3-70b-versatile

# Server config.
PORT=8000
LOG_LEVEL=INFO
ENV=development

# Per-run hard caps. Match the architecture doc defaults; override only
# if you know why.
KEXAR_MAX_STEPS=10
KEXAR_MAX_TOKENS=20000
KEXAR_MAX_COST_USD=0.50

# CORS: comma-separated list of frontend origins allowed to call this API.
# In production set this to your Vercel URL (no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:3000
