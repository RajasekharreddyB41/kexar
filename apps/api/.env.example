# TrueFoundry AI Gateway
TRUEFOUNDRY_API_KEY=tfy-xxxxxxxxxxxxxxxxxxxx
TRUEFOUNDRY_BASE_URL=https://gateway.truefoundry.ai/api/inference/openai

# Model identifiers as configured in TrueFoundry
# Get exact strings from the TrueFoundry playground model dropdown.
# Only Groq is wired up for the hackathon. The other three are simulated
# failures in the cascade. See README for details.
TRUEFOUNDRY_MODEL_CLAUDE=simulated-claude-sonnet-4-5
TRUEFOUNDRY_MODEL_GPT4O=simulated-gpt-4o
TRUEFOUNDRY_MODEL_GEMINI=simulated-gemini-2-5-flash
TRUEFOUNDRY_MODEL_GROQ=groq/llama-3.3-70b-versatile

# Supabase Postgres (filled in on Day 1 task 6, leave placeholder for now)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Server
PORT=8000
LOG_LEVEL=INFO
ENV=development

# Per-run hard caps (matches architecture doc)
KEXAR_MAX_STEPS=10
KEXAR_MAX_TOKENS=20000
KEXAR_MAX_COST_USD=0.50

# CORS - the Vercel frontend domain
CORS_ALLOWED_ORIGINS=http://localhost:3000
